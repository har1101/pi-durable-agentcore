{
  "name": "pi-durable-agentcore-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "demo:submit": "node dist/demo-worker.js submit",
    "demo:resume": "node dist/demo-worker.js resume",
    "pretest": "npm run build",
    "test": "bash scripts/with-dynamodb-local.sh npx vitest run",
    "demo:crash-resume": "bash scripts/with-dynamodb-local.sh bash scripts/demo-crash-resume.sh",
    "sync:infra": "npm run build && node scripts/sync-wake-sweeper.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
